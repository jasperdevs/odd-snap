<Window x:Class="OddSnap.UI.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OddSnap.UI.Controls"
        Title="Text capture"
        Height="520" Width="580"
        MinHeight="400" MinWidth="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        Icon="pack://application:,,,/Assets/oddsnap.ico"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <!-- Theme brushes are published by ApplyTheme() in the ctor from the
             UI.Theme token set (app-level copies exist via Theme.ApplyTo).
             Do not add hardcoded brush values here — they would be dark-only. -->
        <SolidColorBrush x:Key="TranslationShimmerBrush" Color="#14FFFFFF"/>

        <Style x:Key="OcrThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBd"
                                CornerRadius="3"
                                Background="{DynamicResource ThemeScrollThumbBrush}"
                                Margin="2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBd" Property="Background"
                                        Value="{DynamicResource ThemeScrollThumbHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBd" Property="Background"
                                        Value="{DynamicResource ThemeScrollThumbHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OcrScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <!-- Slim by default, widens on hover so it is easier to grab.
                 The dropdown panel reserves extra width (see the Popup border
                 margin in OcrComboBoxStyle) so the growth does not overlap the
                 items. -->
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent"
                              Width="{TemplateBinding Width}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource OcrThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Width" Value="10"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="MinHeight" Value="6"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="Orientation" Value="Horizontal"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Height" Value="10"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OcrComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeInputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="MaxDropDownHeight" Value="280"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid MinWidth="{TemplateBinding MinWidth}" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleSite"
                                          MinWidth="{TemplateBinding MinWidth}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Border x:Name="Bd"
                                        MinWidth="{TemplateBinding MinWidth}"
                                        MinHeight="{TemplateBinding MinHeight}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="3"
                                        Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter x:Name="ContentSite"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                          IsHitTestVisible="False"
                                                          Margin="0,0,6,0"
                                                          RecognizesAccessKey="True"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        <TextBox x:Name="PART_EditableTextBox"
                                                 Margin="0,0,6,0"
                                                 Padding="0"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{TemplateBinding Foreground}"
                                                 CaretBrush="{TemplateBinding Foreground}"
                                                 VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                 Visibility="Collapsed"
                                                 Focusable="True"/>
                                        <Path Grid.Column="1"
                                              Width="8"
                                              Height="4"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="{DynamicResource ThemeTextSecondaryBrush}"/>
                                    </Grid>
                                </Border>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <!-- Panel is a little wider than the closed
                                     ComboBox so the hover-widened scrollbar sits
                                     inside the panel instead of on top of it. -->
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,8,0"
                                        Background="{DynamicResource ThemeCardBrush}"
                                        BorderBrush="{DynamicResource ThemeInputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer Padding="4,4,0,4"
                                                  CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="{x:Type ScrollBar}"
                                                   BasedOn="{StaticResource OcrScrollBarStyle}"/>
                                        </ScrollViewer.Resources>
                                        <!-- Reserve room on the right so the scrollbar
                                             can widen on hover without covering text. -->
                                        <ItemsPresenter Margin="0,0,10,0"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeTextSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OcrComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ThemeScrollThumbBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ThemeScrollThumbBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OcrTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeTextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, Malgun Gothic, Yu Gothic UI, Arial Unicode MS, Segoe UI Symbol"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Grid>
                            <!-- Apply the scrollbar style here, not via TextBox.Resources:
                                 the PART_ContentHost ScrollViewer resolves scrollbars from
                                 this template scope, so an implicit style declared on the
                                 TextBox itself is not picked up. -->
                            <ScrollViewer x:Name="PART_ContentHost">
                                <ScrollViewer.Resources>
                                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource OcrScrollBarStyle}"/>
                                </ScrollViewer.Resources>
                            </ScrollViewer>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="12" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:OddSnapTitleBar Grid.Row="0"
                                      Title="Text capture"
                                      CloseRequested="TitleBar_CloseRequested"/>

            <Border Grid.Row="1" Margin="14,0,14,0" CornerRadius="8" Padding="2"
                    Background="{DynamicResource ThemeInputBackgroundBrush}"
                    BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1">
                <TextBox x:Name="OcrTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="13"
                         Padding="10,8"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                         CaretBrush="{DynamicResource ThemeTextPrimaryBrush}"
                         Style="{StaticResource OcrTextBoxStyle}"/>
            </Border>

            <Border Grid.Row="2" Margin="14,8,14,0">
                <StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <ComboBox x:Name="FromLanguageCombo" FontSize="11" Padding="6,4" MinWidth="110"
                                  Margin="0,0,6,6"
                                  IsEditable="True" IsTextSearchEnabled="False"
                                  Style="{StaticResource OcrComboBoxStyle}"
                                  ItemContainerStyle="{StaticResource OcrComboBoxItemStyle}"
                                  PreviewTextInput="FilterCombo_PreviewTextInput" PreviewKeyDown="FilterCombo_PreviewKeyDown"
                                  SelectionChanged="FromLanguageCombo_Changed"/>
                        <TextBlock Text="→" FontSize="14" Margin="0,0,6,6" VerticalAlignment="Center" Opacity="0.35"
                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontWeight="Bold"/>
                        <ComboBox x:Name="ToLanguageCombo" FontSize="11" Padding="6,4" MinWidth="110"
                                  Margin="0,0,8,6"
                                  IsEditable="True" IsTextSearchEnabled="False"
                                  Style="{StaticResource OcrComboBoxStyle}"
                                  ItemContainerStyle="{StaticResource OcrComboBoxItemStyle}"
                                  PreviewTextInput="FilterCombo_PreviewTextInput" PreviewKeyDown="FilterCombo_PreviewKeyDown"
                                  SelectionChanged="ToLanguageCombo_Changed"/>
                        <Border Width="1" Height="18" Background="{DynamicResource ThemeInputBorderBrush}" Margin="0,0,8,6"/>
                        <ComboBox x:Name="ModelCombo" FontSize="10" Padding="5,4" MinWidth="115"
                                  Margin="0,0,8,6"
                                  Style="{StaticResource OcrComboBoxStyle}"
                                  ItemContainerStyle="{StaticResource OcrComboBoxItemStyle}"
                                  SelectionChanged="ModelCombo_Changed">
                            <ComboBoxItem Content="Local model" Tag="2"/>
                            <ComboBoxItem Content="Argos (offline)" Tag="0"/>
                            <ComboBoxItem Content="Google Translate" Tag="1"/>
                        </ComboBox>

                        <Button x:Name="TranslateBtn" Content="Translate"
                                FontSize="12" Padding="16,6" Margin="0,0,0,6"
                                Click="TranslateBtn_Click" Style="{StaticResource ChromeButtonBase}"
                                Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                Background="{DynamicResource ThemeInputBackgroundBrush}"
                                BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1"
                                Cursor="Hand" MinHeight="30" FontWeight="SemiBold"/>
                    </WrapPanel>
                    <TextBlock x:Name="TranslationPreferenceStatusText"
                               FontSize="11"
                               Margin="2,6,0,0"
                               Opacity="0.45"
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Margin="14,8,14,0"
                    CornerRadius="8" Padding="2"
                    Background="{DynamicResource ThemeInputBackgroundBrush}"
                    BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1"
                    MinHeight="70" MaxHeight="200">
                <Grid>
                    <TextBox x:Name="TranslatedTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" IsReadOnly="True"
                             FontSize="13" FontFamily="Segoe UI"
                             Padding="10,8"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                             CaretBrush="{DynamicResource ThemeTextPrimaryBrush}"
                             Style="{StaticResource OcrTextBoxStyle}"/>
                    <Border x:Name="TranslationLoadingOverlay"
                            Background="#0DFFFFFF"
                            CornerRadius="6"
                            Margin="6"
                            Visibility="Collapsed"
                            ClipToBounds="True"
                            IsHitTestVisible="False">
                        <Grid>
                            <Rectangle x:Name="TranslationShimmerRect" Fill="{DynamicResource TranslationShimmerBrush}" RadiusX="6" RadiusY="6"/>
                            <StackPanel Margin="12,8,12,8" VerticalAlignment="Center">
                                <Border Height="10" Width="150" CornerRadius="5" Background="#12FFFFFF" HorizontalAlignment="Left"/>
                                <Border Height="8" Margin="0,8,0,0" CornerRadius="4" Background="#0EFFFFFF"/>
                                <Border Height="8" Margin="0,6,42,0" CornerRadius="4" Background="#0EFFFFFF"/>
                                <ProgressBar x:Name="TranslateProgressBar"
                                             Height="3"
                                             Margin="0,10,0,0"
                                             IsIndeterminate="True"
                                             Opacity="0.9"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="TranslateStatus" FontSize="11"
                               Opacity="0.25" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                               Margin="16,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                               IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Border Grid.Row="4" Padding="14,10,14,12">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button x:Name="CopyTranslationBtn" Content="Copy result" FontSize="11" Padding="10,6" Margin="0,0,6,4"
                                Click="CopyTranslationBtn_Click" Style="{StaticResource ChromeButtonBase}"
                                Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                Background="{DynamicResource ThemeInputBackgroundBrush}"
                                BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1"
                                Cursor="Hand" MinHeight="30" Visibility="Collapsed"/>
                        <Button x:Name="CopyBtn" Content="Copy text" FontSize="11" Padding="10,6" Margin="0,0,0,4"
                                Click="CopyBtn_Click" Style="{StaticResource ChromeButtonBase}"
                                Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                Background="{DynamicResource ThemeInputBackgroundBrush}"
                                BorderBrush="{DynamicResource ThemeInputBorderBrush}" BorderThickness="1"
                                Cursor="Hand" MinHeight="30"/>
                    </WrapPanel>
                    <TextBlock x:Name="CharCountText" FontSize="10.5" Opacity="0.3" VerticalAlignment="Center"
                               Margin="0,0,12,4"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}" FontFamily="Segoe UI Variable Text"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
